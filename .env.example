# ─── Required ─────────────────────────────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Your Discord application/client ID
DISCORD_CLIENT_ID=

# Any long random string used to sign sessions
SESSION_SECRET=change_me_to_a_long_random_string

# ─── Optional ─────────────────────────────────────────────────────────────────
# HTTP port for the health-check endpoint (defaults to 8080 if not set)
# PORT=8080

# Absolute path to the SQLite database file.
# Default: bot.db in the working directory (artifacts/api-server/bot.db).
# Set this on WispByte / VPS to a path on a persistent volume so data
# survives container restarts and re-deploys.
# DATABASE_PATH=/data/bot.db
